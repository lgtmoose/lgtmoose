{
  "name": "@lgtmoose/cdk",
  "version": "0.0.0",
  "private": true,
  "description": "AWS CDK app for LGTMoose. Stacks: network, data, api, proxy, workflow, dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "test": "vitest run",
    "synth": "cdk synth --quiet"
  },
  "dependencies": {
    "@lgtmoose/config": "workspace:*",
    "@lgtmoose/control": "workspace:*",
    "@lgtmoose/db": "workspace:*",
    "@lgtmoose/egress-proxy": "workspace:*",
    "@lgtmoose/gateway": "workspace:*",
    "@lgtmoose/harness": "workspace:*",
    "aws-cdk-lib": "^2.276.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1169.0",
    "@types/aws-lambda": "^8.10.164",
    "aws-cdk": "^2.1148.1",
    "typescript": "catalog:"
  }
}
