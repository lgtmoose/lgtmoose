# Copy to .env and fill in. Every value here is a placeholder: generate your own.
# See docs/compose.md.

# Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres-password
# The gateway's login, which can only add jobs. At least 16 characters: openssl rand -hex 24
GATEWAY_DB_PASSWORD=change-me-gateway-password

# The GitHub App's webhook secret, as `lgtmoose setup` printed it or the App's settings show it.
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated orgs or users whose repositories LGTMoose reviews (allowedOrgs in the config).
ALLOWED_ORGS=your-org

# The hosts the egress proxy allows: print them for your config with
#   docker compose run --rm --no-deps --entrypoint node runner /app/dist/local/egress-hosts.js
# The runner refuses to start when this doesn't match the config.
LGTMOOSE_EGRESS_HOSTS=api.anthropic.com

# The group that owns the Docker socket here: stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Where webhooks come in. Keep 127.0.0.1 behind a reverse proxy or tunnel on this host.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3000
# 1 behind one reverse proxy or tunnel; 0 when GATEWAY_PORT is reached directly.
TRUST_PROXY_HOPS=1

# The dashboard (docker compose --profile dashboard up -d). Its login, 16+ characters:
#   openssl rand -hex 24
DASHBOARD_DB_PASSWORD=change-me-dashboard-password
# Where people open it, behind your reverse proxy: https only, no path.
DASHBOARD_ORIGIN=https://lgtmoose.example.com
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3001

# Reviews run at once per runner, and each sandbox's size.
LGTMOOSE_MAX_EXECUTIONS=2
LGTMOOSE_SANDBOX_MEMORY_MB=4096
LGTMOOSE_SANDBOX_CPUS=2
# With several runners (docker compose up -d --scale runner=2): how long a runner's heartbeat
# may be silent before the others fail its reviews and remove its sandboxes.
LGTMOOSE_RUNNER_STALE_SECONDS=120
