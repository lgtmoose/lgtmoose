{
  "name": "@lgtmoose/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres schema, migrations and migration runner for LGTMoose.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "generate": "tsx scripts/generate.ts",
    "check-migrations": "tsx scripts/check-migrations.ts",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  }
}
