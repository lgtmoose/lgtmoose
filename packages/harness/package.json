{
  "name": "@lgtmoose/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Runs a vendor's coding agent CLI headless on one review batch, with read-only tools, and returns its JSON output validated with zod.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "@aws-sdk/client-s3": "^3.1167.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
