{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "region": {
      "default": "us-east-1",
      "type": "string",
      "pattern": "^[a-z]{2}(-gov)?-[a-z]+-\\d$"
    },
    "profile": {
      "default": "lean",
      "type": "string",
      "enum": [
        "lean",
        "standard"
      ]
    },
    "allowedOrgs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
      }
    },
    "providers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "cursor-agent",
              "agent-sdk"
            ]
          },
          "auth": {
            "type": "string",
            "enum": [
              "oauth-token",
              "api-key",
              "bedrock",
              "vertex",
              "chatgpt-login",
              "access-token",
              "service-account"
            ]
          },
          "models": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "fast",
                "standard",
                "deep"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[\\w.:@/[\\]-]{1,128}$"
            }
          },
          "vertex": {
            "type": "object",
            "properties": {
              "region": {
                "default": "global",
                "type": "string",
                "pattern": "^(global|us|eu|[a-z]+-[a-z]+\\d+)$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
              }
            },
            "additionalProperties": false
          },
          "concurrency": {
            "description": "Sandbox tasks that may use this provider's credential at once, across reviews.",
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "required": [
          "id",
          "harness",
          "auth"
        ],
        "additionalProperties": false
      }
    },
    "roles": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "reviewer",
          "crossFile",
          "verifier",
          "replyJudge",
          "ticketExtractor"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "maxConcurrency": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "reconcileIntervalMinutes": {
      "default": 30,
      "description": "Minutes between reconciler runs, which catch missed webhooks and drifted status labels.",
      "type": "integer",
      "minimum": 5,
      "maximum": 1440
    },
    "reconcileLookbackHours": {
      "default": 24,
      "description": "Hours back the reconciler queues reviews for: only PRs updated within this window. At least the interval.",
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    },
    "feedback": {
      "default": {
        "acceptanceThreshold": 0.5,
        "minSamples": 10,
        "maxCommentsPerRun": 100
      },
      "type": "object",
      "properties": {
        "acceptanceThreshold": {
          "default": 0.5,
          "description": "Acceptance below which a rule category is flagged for a person to look at.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minSamples": {
          "default": 10,
          "description": "Accepted plus rejected findings a category needs before it's judged.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxCommentsPerRun": {
          "default": 100,
          "description": "Most inline comments whose reactions one reconciler run reads (one GitHub call each). 0 stops reading them.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "maxReplyJudgements": {
      "default": 10,
      "description": "Most replies on LGTMoose's findings judged per run (one fast-tier model call each). 0 turns the reply judge off.",
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "shadow": {
      "default": true,
      "description": "Record reviews to the artifact bucket and the log instead of posting them to GitHub.",
      "type": "boolean"
    },
    "extraEgressHosts": {
      "default": [],
      "description": "Extra hosts sandbox tasks may reach through the egress proxy, on top of the providers' model APIs. Exact hostnames only.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$"
      }
    },
    "learnings": {
      "default": {
        "embeddings": {
          "provider": "none"
        }
      },
      "type": "object",
      "properties": {
        "embeddings": {
          "default": {
            "provider": "none"
          },
          "description": "How learnings are ranked against a batch's diff: bedrock or openai embeddings, or none for keywords. The provider receives learning text and diffs.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "provider"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "bedrock"
                },
                "model": {
                  "default": "amazon.titan-embed-text-v2:0",
                  "type": "string",
                  "pattern": "^amazon\\.titan-embed-text-v2(?::\\d+)?$"
                }
              },
              "required": [
                "provider"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "openai"
                },
                "model": {
                  "default": "text-embedding-3-small",
                  "type": "string",
                  "pattern": "^text-embedding-3-(?:small|large)$"
                }
              },
              "required": [
                "provider"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tickets": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "linear",
            "jira",
            "github-issues"
          ]
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "dashboard": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "allowedOrgs",
    "providers"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/lgtmoose/lgtmoose/main/packages/config/schema/lgtmoose.config.schema.json",
  "title": "LGTMoose deployment config (lgtmoose.config.ts)"
}
