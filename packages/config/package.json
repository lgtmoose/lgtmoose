{
  "name": "@lgtmoose/config",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas and defaults for lgtmoose.config.ts (deployment) and .lgtmoose.yaml (per repo).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "tsx scripts/write-json-schema.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
