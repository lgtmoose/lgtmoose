{
  "name": "@lgtmoose/poster",
  "version": "0.0.0",
  "private": true,
  "description": "Posts a review run to GitHub: one review with inline comments, the LGTMoose check run, the summary comment and status labels. Shadow mode records it instead.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "@lgtmoose/core": "workspace:*",
    "@lgtmoose/git": "workspace:*",
    "@lgtmoose/summary": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
