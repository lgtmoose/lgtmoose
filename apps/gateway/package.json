{
  "name": "@lgtmoose/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Webhook and REST gateway for LGTMoose, run as a Lambda behind API Gateway.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@lgtmoose/core": "workspace:*",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "catalog:"
  }
}
