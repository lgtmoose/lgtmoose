{
  "name": "lgtmoose",
  "version": "0.0.0",
  "private": true,
  "description": "CLI for LGTMoose: set up, authenticate, deploy and dry-run reviews.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "lgtmoose": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1169.0",
    "@aws-sdk/client-cloudformation": "^3.1167.0",
    "@aws-sdk/client-rds": "^3.1167.0",
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-sts": "^3.1167.0",
    "@inquirer/prompts": "^8.8.0",
    "@lgtmoose/config": "workspace:*",
    "@lgtmoose/core": "workspace:*",
    "@lgtmoose/git": "workspace:*",
    "@lgtmoose/harness": "workspace:*",
    "@lgtmoose/pipeline": "workspace:*",
    "@lgtmoose/poster": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.10.0",
    "typescript": "catalog:"
  }
}
