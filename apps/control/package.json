{
  "name": "@lgtmoose/control",
  "version": "0.0.0",
  "private": true,
  "description": "Control task for the review workflow: prepares batches and posts results. Holds the GitHub App credentials; never runs a model.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json .",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-sfn": "^3.1167.0",
    "@aws-sdk/client-sts": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@lgtmoose/config": "workspace:*",
    "@lgtmoose/core": "workspace:*",
    "@lgtmoose/db": "workspace:*",
    "@lgtmoose/git": "workspace:*",
    "@lgtmoose/pipeline": "workspace:*",
    "@lgtmoose/poster": "workspace:*",
    "@lgtmoose/summary": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@types/pg": "^8.23.1",
    "typescript": "catalog:"
  }
}
