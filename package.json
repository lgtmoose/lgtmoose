{
  "name": "lgtmoose-monorepo",
  "private": true,
  "description": "LGTMoose: a self-hosted, open-source AI pull request reviewer you deploy to your own AWS account.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "synth": "turbo run synth",
    "lgtmoose": "pnpm --silent --filter \"lgtmoose...\" --filter \"@lgtmoose/cdk...\" build && node apps/cli/dist/index.js",
    "check": "turbo run format:check lint typecheck test test:integration build smoke check-migrations synth",
    "db:test:start": "docker run -d --name lgtmoose-test-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 \"$(sed -n 's/^FROM //p' tools/test-postgres/Dockerfile)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lgtmoose/config": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
