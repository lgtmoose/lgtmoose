{
  "name": "lgtmoose-monorepo",
  "private": true,
  "description": "LGTMoose: a self-hosted, open-source AI pull request reviewer you deploy to your own AWS account.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint lint:root",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "synth": "turbo run synth",
    "evals": "pnpm --silent --filter \"@lgtmoose/evals...\" build && node packages/evals/dist/main.js",
    "lgtmoose": "pnpm --silent --filter \"lgtmoose...\" --filter \"@lgtmoose/cdk...\" build && node apps/cli/dist/index.js",
    "check": "turbo run format:check lint:root lint typecheck test test:integration build smoke check-migrations synth",
    "db:test:start": "docker run -d --name lgtmoose-test-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 \"$(sed -n 's/^FROM //p' tools/test-postgres/Dockerfile)\"",
    "lint:root": "oxlint --deny-warnings --no-error-on-unmatched-pattern -c .oxlintrc.json --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"infra/**\" ."
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@lgtmoose/config": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
