{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "tsconfig.base.json",
    ".nvmrc",
    "pnpm-workspace.yaml",
    ".oxlintrc.json",
    "tools/test-postgres/Dockerfile",
    ".github/workflows/ci.yml",
    ".github/actions/**"
  ],
  "tasks": {
    "//#format:check": {
      "inputs": ["**/*", "!**/node_modules/**", "!**/dist/**", "!**/cdk.out/**", "!.turbo/**"]
    },
    "//#lint:root": {
      "inputs": [
        "**/*.{js,mjs,cjs,ts,mts,cts,tsx}",
        "!apps/**",
        "!packages/**",
        "!infra/**",
        "!**/node_modules/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["LGTMOOSE_TEST_DATABASE_URL", "LGTMOOSE_TEST_DOCKER", "LGTMOOSE_TEST_IMAGE", "CI"]
    },
    "smoke": {
      "dependsOn": ["build"]
    },
    "check-migrations": {
      "cache": false
    },
    "synth": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/lgtmoose.config.ts"],
      "env": [
        "LGTMOOSE_CONFIG",
        "CDK_DEFAULT_ACCOUNT",
        "CDK_DEFAULT_REGION",
        "LGTMOOSE_ALLOW_UNVERIFIED_CURSOR"
      ],
      "outputs": ["cdk.out/**"]
    }
  }
}
