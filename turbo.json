{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "tasks": {
    "//#format:check": {
      "inputs": ["**/*", "!**/node_modules/**", "!**/dist/**", "!**/cdk.out/**", "!.turbo/**"]
    },
    "//#lint": {
      "inputs": [
        "**/*.{js,mjs,cjs,ts,mts,cts,tsx}",
        "eslint.config.js",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/cdk.out/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["LGTMOOSE_TEST_DATABASE_URL", "CI"]
    },
    "smoke": {
      "dependsOn": ["build"]
    },
    "check-migrations": {
      "cache": false
    },
    "synth": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/lgtmoose.config.ts"],
      "env": ["LGTMOOSE_CONFIG", "CDK_DEFAULT_ACCOUNT", "CDK_DEFAULT_REGION"],
      "outputs": ["cdk.out/**"]
    }
  }
}
